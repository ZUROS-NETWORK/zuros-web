---
import "./ProductCard.css";

interface Props {
  product: any;
  defaultVisible: boolean;
}

const { product, defaultVisible } = Astro.props;

const { id, image, name, short_description, total_price, currency } = product;

function parseProductName(text: string) {
  if (!text) {
    return {
      name: "",
      duration: null,
      discount: null,
    };
  }

  const parts = [...text.matchAll(/[\[(]([^[\]()]+)[\])]/g)];

  let duration = null;
  let discount = null;

  for (const part of parts) {
    const value = part[1].trim();

    const discountMatch = value.match(/^-(\d+)%$/);

    if (discountMatch) {
      discount = Number(discountMatch[1]);
    } else if (!duration) {
      duration = value;
    }
  }

  const cleanName = text
    .replace(/[\[(][^[\]()]+[\])]/g, "")
    .replace(/\s+/g, " ")
    .trim();

  return {
    name: cleanName,
    duration,
    discount,
  };
}

const parsedData = parseProductName(name);

const productName = parsedData.name;
const customDiscount = parsedData.discount;

const originalPrice =
  customDiscount && customDiscount > 0
    ? total_price / (1 - customDiscount / 100)
    : null;
---

<style>
  .cursor-pointer {
    cursor: pointer;
  }
</style>

<div
  class="product-card"
  data-product-id={id}
  data-category-id={product.category_id}
  style={defaultVisible ? "" : "display: none;"}
>
  <div class="product-card-image cursor-pointer btn-details-trigger">
    <img src={image} alt={name} loading="lazy" />
    <div class="product-card-overlay"></div>

    {
      parsedData.duration && (
        <div class="product-card-label">{parsedData.duration}</div>
      )
    }

    {customDiscount && <div class="discount-label">-{customDiscount}%</div>}
  </div>

  <div class="product-card-content cursor-pointer btn-details-trigger">
    <h3 class="product-card-title">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"
        ></circle>
      </svg>

      {productName}
    </h3>

    <p class="product-card-text">
      {short_description}
    </p>
  </div>

  <div class="product-card-price cursor-pointer btn-details-trigger">
    {
      originalPrice && (
        <p class="old-price">
          ${originalPrice.toFixed(2)} {currency}
        </p>
      )
    }

    <p class="new-price">
      ${total_price.toFixed(2)}
      {currency}
    </p>
  </div>

  <div class="product-card-actions">
    <button class="btn btn-details btn-details-trigger"> Ver detalles </button>

    <button
      class="btn btn-buy btn-add-to-cart-trigger"
      data-product={JSON.stringify(product)}
    >
      Comprar
    </button>
  </div>
</div>
